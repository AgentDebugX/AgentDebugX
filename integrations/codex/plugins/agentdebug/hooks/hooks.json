{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agentdebug integrations capture dispatch --platform codex",
            "timeout": 10,
            "statusMessage": "agentdebug-capture"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agentdebug integrations capture dispatch --platform codex",
            "timeout": 10,
            "statusMessage": "agentdebug-capture"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agentdebug integrations capture dispatch --platform codex",
            "timeout": 10,
            "statusMessage": "agentdebug-capture"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "agentdebug integrations capture dispatch --platform codex",
            "timeout": 3,
            "statusMessage": "agentdebug-capture"
          }
        ]
      }
    ]
  }
}
