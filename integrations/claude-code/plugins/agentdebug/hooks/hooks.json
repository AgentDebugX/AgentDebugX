{
  "description": "Passively capture enabled Claude Code project sessions for AgentDebugX.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/agentdebug-hook\" --platform claude",
            "commandWindows": "cmd.exe /d /s /c call \"%CLAUDE_PLUGIN_ROOT%\\bin\\agentdebug-hook.cmd\" claude",
            "timeout": 10,
            "statusMessage": "agentdebug-capture"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/agentdebug-hook\" --platform claude",
            "commandWindows": "cmd.exe /d /s /c call \"%CLAUDE_PLUGIN_ROOT%\\bin\\agentdebug-hook.cmd\" claude",
            "timeout": 10,
            "statusMessage": "agentdebug-capture"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/agentdebug-hook\" --platform claude",
            "commandWindows": "cmd.exe /d /s /c call \"%CLAUDE_PLUGIN_ROOT%\\bin\\agentdebug-hook.cmd\" claude",
            "timeout": 10,
            "statusMessage": "agentdebug-capture"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/agentdebug-hook\" --platform claude",
            "commandWindows": "cmd.exe /d /s /c call \"%CLAUDE_PLUGIN_ROOT%\\bin\\agentdebug-hook.cmd\" claude",
            "timeout": 10,
            "statusMessage": "agentdebug-capture"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/agentdebug-hook\" --platform claude",
            "commandWindows": "cmd.exe /d /s /c call \"%CLAUDE_PLUGIN_ROOT%\\bin\\agentdebug-hook.cmd\" claude",
            "timeout": 10,
            "statusMessage": "agentdebug-capture"
          }
        ]
      }
    ]
  }
}
